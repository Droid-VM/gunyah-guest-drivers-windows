[XcbVirtioAudio.I.TopologyIn2.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.TopologyIn2%

[XcbVirtioAudio.I.WaveOut3]
AddReg = XcbVirtioAudio.I.WaveOut3.AddReg

[XcbVirtioAudio.I.WaveOut3.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.WaveOut3%

[XcbVirtioAudio.I.TopologyOut3]
AddReg = XcbVirtioAudio.I.TopologyOut3.AddReg

[XcbVirtioAudio.I.TopologyOut3.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.TopologyOut3%

[XcbVirtioAudio.I.WaveIn3]
AddReg = XcbVirtioAudio.I.WaveIn3.AddReg

[XcbVirtioAudio.I.WaveIn3.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.WaveIn3%

[XcbVirtioAudio.I.TopologyIn3]
AddReg = XcbVirtioAudio.I.TopologyIn3.AddReg

[XcbVirtioAudio.I.TopologyIn3.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.TopologyIn3%

[XcbVirtioAudio.I.WaveOut4]
AddReg = XcbVirtioAudio.I.WaveOut4.AddReg

[XcbVirtioAudio.I.WaveOut4.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.WaveOut4%

[XcbVirtioAudio.I.TopologyOut4]
AddReg = XcbVirtioAudio.I.TopologyOut4.AddReg

[XcbVirtioAudio.I.TopologyOut4.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.TopologyOut4%

[XcbVirtioAudio.I.WaveIn4]
AddReg = XcbVirtioAudio.I.WaveIn4.AddReg

[XcbVirtioAudio.I.WaveIn4.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.WaveIn4%

[XcbVirtioAudio.I.TopologyIn4]
AddReg = XcbVirtioAudio.I.TopologyIn4.AddReg

[XcbVirtioAudio.I.TopologyIn4.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.TopologyIn4%

[XcbVirtioAudio_Device.NT.Services]
AddService = viosnd,0x00000002,XcbVirtioAudio_Service_Install

[XcbVirtioAudio_Service_Install]
DisplayName    = %XcbVirtioAudio.Service%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %INX_PLATFORM_DRIVERS_DIR%\viosnd.sys
AddReg         = DmaRemappingCompatible.Reg

[DmaRemappingCompatible.Reg]
HKR,Parameters,DmaRemappingCompatible,0x00010001,0

