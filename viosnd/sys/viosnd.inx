;/*++
;
;INX_COPYRIGHT_1
;INX_COPYRIGHT_2
;
;Module Name:
;    viosnd.inf
;
;Abstract:
;    XCB Virtio Audio driver installation file.
;
;--*/

[Version]
Signature       = "$WINDOWS NT$"
Class           = MEDIA
ClassGuid       = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider        = %VENDOR%
CatalogFile     = viosnd.cat
PnpLockdown     = 1
DriverVer       = 01/01/2008,0.0.0.1 ; this line will be replaced with stampinf

[DestinationDirs]
DefaultDestDir = INX_PLATFORM_DRIVERS_DIR

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
viosnd.sys = 1,,

[Manufacturer]
%VENDOR% = Standard,NT$ARCH$

[Standard.NT$ARCH$]
%XcbVirtioAudio.DeviceDesc% = XcbVirtioAudio_Device, PCI\VEN_1AF4&DEV_1059&SUBSYS_1100_INX_SUBSYS_VENDOR_ID&REV_01, PCI\VEN_1AF4&DEV_1059

[XcbVirtioAudio_Device.NT]
CopyFiles = XcbVirtioAudio_CopyFiles

[XcbVirtioAudio_Device.NT.HW]
AddReg = XcbVirtioAudio_AddReg

[XcbVirtioAudio_Device.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveOut%,     XcbVirtioAudio.I.WaveOut
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveOut%,     XcbVirtioAudio.I.WaveOut
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveOut%,     XcbVirtioAudio.I.WaveOut
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyOut%, XcbVirtioAudio.I.TopologyOut
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyOut%, XcbVirtioAudio.I.TopologyOut
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveIn%,      XcbVirtioAudio.I.WaveIn
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveIn%,      XcbVirtioAudio.I.WaveIn
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveIn%,      XcbVirtioAudio.I.WaveIn
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyIn%,  XcbVirtioAudio.I.TopologyIn
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyIn%,  XcbVirtioAudio.I.TopologyIn
; A card may carry several endpoints in a direction. Windows binds a subdevice to a name from
; this file, so the number of endpoints that can ever be exposed is decided here rather than at
; run time; the driver registers as many as the host offered, up to this many. The first keeps
; the unsuffixed names so that upgrading does not orphan the endpoint whose volume and default
; the user has already set.
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveOut2%,     XcbVirtioAudio.I.WaveOut2
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveOut2%,     XcbVirtioAudio.I.WaveOut2
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveOut2%,     XcbVirtioAudio.I.WaveOut2
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyOut2%, XcbVirtioAudio.I.TopologyOut2
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyOut2%, XcbVirtioAudio.I.TopologyOut2
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveIn2%,      XcbVirtioAudio.I.WaveIn2
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveIn2%,      XcbVirtioAudio.I.WaveIn2
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveIn2%,      XcbVirtioAudio.I.WaveIn2
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyIn2%,  XcbVirtioAudio.I.TopologyIn2
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyIn2%,  XcbVirtioAudio.I.TopologyIn2
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveOut3%,     XcbVirtioAudio.I.WaveOut3
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveOut3%,     XcbVirtioAudio.I.WaveOut3
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveOut3%,     XcbVirtioAudio.I.WaveOut3
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyOut3%, XcbVirtioAudio.I.TopologyOut3
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyOut3%, XcbVirtioAudio.I.TopologyOut3
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveIn3%,      XcbVirtioAudio.I.WaveIn3
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveIn3%,      XcbVirtioAudio.I.WaveIn3
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveIn3%,      XcbVirtioAudio.I.WaveIn3
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyIn3%,  XcbVirtioAudio.I.TopologyIn3
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyIn3%,  XcbVirtioAudio.I.TopologyIn3
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveOut4%,     XcbVirtioAudio.I.WaveOut4
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveOut4%,     XcbVirtioAudio.I.WaveOut4
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveOut4%,     XcbVirtioAudio.I.WaveOut4
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyOut4%, XcbVirtioAudio.I.TopologyOut4
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyOut4%, XcbVirtioAudio.I.TopologyOut4
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveIn4%,      XcbVirtioAudio.I.WaveIn4
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveIn4%,      XcbVirtioAudio.I.WaveIn4
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveIn4%,      XcbVirtioAudio.I.WaveIn4
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyIn4%,  XcbVirtioAudio.I.TopologyIn4
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyIn4%,  XcbVirtioAudio.I.TopologyIn4

[XcbVirtioAudio_CopyFiles]
viosnd.sys

[XcbVirtioAudio_AddReg]
HKR,Interrupt Management,,0x00000010
HKR,Interrupt Management\MessageSignaledInterruptProperties,,0x00000010
HKR,Interrupt Management\MessageSignaledInterruptProperties,MSISupported,0x00010001,1
HKR,Interrupt Management\MessageSignaledInterruptProperties,MessageNumberLimit,0x00010001,4
HKR,,EndpointRole,0x00010001,2

[XcbVirtioAudio.I.WaveOut]
AddReg = XcbVirtioAudio.I.WaveOut.AddReg

[XcbVirtioAudio.I.WaveOut.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.WaveOut%

[XcbVirtioAudio.I.TopologyOut]
AddReg = XcbVirtioAudio.I.TopologyOut.AddReg

[XcbVirtioAudio.I.TopologyOut.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.TopologyOut%

[XcbVirtioAudio.I.WaveIn]
AddReg = XcbVirtioAudio.I.WaveIn.AddReg

[XcbVirtioAudio.I.WaveIn.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.WaveIn%

[XcbVirtioAudio.I.TopologyIn]
AddReg = XcbVirtioAudio.I.TopologyIn.AddReg

[XcbVirtioAudio.I.TopologyIn.AddReg]
HKR,,FriendlyName,,%XcbVirtioAudio.TopologyIn%
HKR,EP\0,%PKEY_AudioEndpoint_Default_VolumeInDb%,0x00010001,0x00000000

[XcbVirtioAudio.I.WaveOut2]
AddReg = XcbVirtioAudio.I.WaveOut2.AddReg

[XcbVirtioAudio.I.WaveOut2.AddReg]
